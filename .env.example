# Provider: "fake" (offline, deterministic, no key) or "gemini"
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# USD per 1M tokens, used only for cost logging. Check current pricing before relying on it.
PRICE_INPUT_PER_M_TOKENS=0.30
PRICE_OUTPUT_PER_M_TOKENS=2.50
PRICE_EMBED_PER_M_TOKENS=0.15

DB_PATH=var/sop_index.sqlite3
ACCESS_POLICY_PATH=data/access_policy.json
STAFF_USERS_PATH=data/staff_users.csv

TOP_K=8
MAX_CONTEXT_DOCS=3
# Leave unset to use the per-provider default (fake 0.10, gemini 0.45). Recalibrate if you change the embedding model.
# MIN_RETRIEVAL_SCORE=
LLM_TIMEOUT_S=20
EMBED_TIMEOUT_S=10
MAX_RETRIES=2
CACHE_TTL_S=604800
LOG_LEVEL=INFO
